# Mercury Retrograde — frontend/.dockerignore
# Applies when docker build is run from frontend/ directory.
# Audit reference: P0-4.

# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
.env.local
!.env.example

# ── Node / Next.js artifacts (regenerated in image) ──────────────────────────
node_modules
.next
.turbo
.swc
out
*.tsbuildinfo

# ── Test artifacts ───────────────────────────────────────────────────────────
test-results
playwright-report
coverage
.lighthouseci

# ── Editor & OS ──────────────────────────────────────────────────────────────
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
